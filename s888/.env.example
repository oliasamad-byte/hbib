# =============================================================================
# S888 ENVIRONMENT — copy to .env and fill in
# =============================================================================
#
# REUSE FROM S3: do NOT create new FMP account or Telegram bot.
# Open your existing s3-scanner/.env and copy these three values verbatim:
#
#   FMP_API_KEY
#   TELEGRAM_BOT_TOKEN
#   TELEGRAM_CHAT_ID
#
# One bot, one FMP account, one set of credentials to rotate later.
# S888 messages are prefixed with 📅/📆 so they're visually distinct from S3.
# =============================================================================

# ---- APIs (reuse from S3) ----
FMP_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Schedule ----
MASTER_CLOCK=gst                  # gst | ny
SCAN_START_GST=17:30
SCAN_END_GST=22:30
SCAN_INTERVAL_MIN=10

# ---- Universe ----
UNIVERSE_MAX=200
MIN_PRICE=2.00
MIN_AVG_VOLUME=200000
MIN_INTRADAY_CHANGE_PCT=2.5

# ---- Cap thresholds (USD) ----
CAP_SMALL_MIN=300000000
CAP_SMALL_MAX=2000000000
CAP_MID_MAX=10000000000
CAP_LARGE_MAX=200000000000
# mega = > CAP_LARGE_MAX

# ---- Daily ranking ----
DAILY_TOP_N_DETAILED=3
DAILY_TOP_N_LIST=20
DAILY_STAGE_B_CUT_PER_BUCKET=30
DAILY_SMALL_SEND_IF_EMPTY=false
DAILY_MIDLARGEMEGA_SEND_IF_EMPTY=true

# ---- Weekly ranking ----
WEEKLY_CATALYST_THRESHOLD=7
WEEKLY_WTS_THRESHOLD=12
WEEKLY_TOP_N=20
WEEKLY_TOP_N_DETAILED=3
WEEKLY_SEND_IF_EMPTY=false

# ---- Analyst Activity Score ----
ANALYST_LOOKBACK_DAYS=15
ANALYST_CACHE_HOURS=24

# ---- Earnings warning ----
EARNINGS_WARN_DAYS=7
EARNINGS_URGENT_DAYS=3

# ---- Telegram ----
TELEGRAM_COMBINED=false           # false | daily_only | all

# ---- Rate limit ----
FMP_CONCURRENT_REQUESTS=20

# ---- Paths (resolved relative to project root by default) ----
DATA_DIR=data
LOG_DIR=logs
